{
  "expo": {
    "name": "{{APP_NAME}}",
    "slug": "{{APP_SLUG}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "{{SPLASH_COLOR}}"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "{{BUNDLE_ID}}",
      "infoPlist": {
        "NSCameraUsageDescription": "Cette app utilise la caméra",
        "NSMicrophoneUsageDescription": "Cette app utilise le microphone",
        "NSLocationWhenInUseUsageDescription": "Cette app utilise votre position"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "{{SPLASH_COLOR}}"
      },
      "package": "{{BUNDLE_ID}}",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "{{EAS_PROJECT_ID}}"
      }
    },
    "plugins": [
      "@capacitor/app",
      "@capacitor/splash-screen",
      "@capacitor/status-bar"
    ]
  }
}
