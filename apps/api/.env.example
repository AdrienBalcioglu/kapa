# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/appbuilder

# Redis
REDIS_URL=redis://localhost:6379

# EAS (Expo Application Services)
EAS_TOKEN=your_eas_token
EAS_PROJECT_ID=your_expo_project_id

# S3 Storage
S3_BUCKET=appbuilder-artifacts
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_xxx
# Local development only: accept requests without a token, as a mock user
AUTH_DEV_BYPASS=false

# EAS webhook signature (required in production)
EAS_WEBHOOK_SECRET=xxx

# Origin of the web app allowed by CORS
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development
